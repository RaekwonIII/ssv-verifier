# Comma-separated list of RPC endpoints. The verifier round-robins across them
# with a per-endpoint in-flight cap to avoid overwhelming any single provider.
MAINNET_RPC_URL=https://example-mainnet-rpc-1,https://example-mainnet-rpc-2
HOODI_RPC_URL=https://example-hoodi-rpc
MAINNET_VIEWS_ADDRESS=0x0000000000000000000000000000000000000001
HOODI_VIEWS_ADDRESS=0x0000000000000000000000000000000000000002
THEGRAPH_API_KEY=
# Maximum simultaneous in-flight RPC requests per endpoint (default: 10).
RPC_MAX_INFLIGHT_PER_ENDPOINT=
